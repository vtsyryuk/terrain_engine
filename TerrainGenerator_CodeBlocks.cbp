				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add option="-std=c++17" />
					<Add option="-Wall" />
					<Add option="-DWIN32_LEAN_AND_MEAN" />
					<Add option="-DNOMINMAX" />
				</Compiler>
				<Linker>
					<Add option="-s" />
					<Add option="-lstdc++fs" />
				</Linker>
			</Target>
		</Build>

<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="TerrainGenerator" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/terrain_app" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add option="-std=c++17" />
					<Add option="-Wall" />
					<Add option="-DWIN32_LEAN_AND_MEAN" />
					<Add option="-DNOMINMAX" />
				</Compiler>
				<Linker>
					<Add option="-lstdc++fs" />
				</Linker>
			</Target>
			<Target title="Release">
